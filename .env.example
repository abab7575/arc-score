# Database
DATABASE_PATH=./data/arc-score.db

# Screenshots (local or s3)
SCREENSHOT_STORAGE=local
# S3_BUCKET=arc-score-screenshots
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Scanning
SCAN_CONCURRENCY=3
SCAN_STAGGER_MS=5000
PUPPETEER_EXECUTABLE_PATH=

# App
BASE_URL=http://localhost:3000

# Admin
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=a-random-secret-string-at-least-32-chars

# Customer auth
CUSTOMER_SESSION_SECRET=another-random-secret-string-at-least-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...

# Agency email delivery (Resend REST API)
RESEND_API_KEY=re_...
# Required Resend/Svix webhook signing secret (whsec_...)
RESEND_WEBHOOK_SECRET=whsec_...
DEFAULT_FROM_EMAIL=ARC Report <agency@updates.arcreport.ai>
DEFAULT_REPLY_TO=hello@arcreport.ai

# Anthropic API (for Visual Agent — weekly scans)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini API (for content studio image generation — Nano Banana Pro)
GEMINI_API_KEY=your-gemini-api-key

# Cron authentication
CRON_SECRET=your-secret-here

# Founder reporting
# FOUNDER_DIGEST_EMAILS=founder@example.com
# FOUNDER_ALERT_EMAILS=founder@example.com
# DEFAULT_FROM_EMAIL=ARC Report <alerts@arcreport.ai>
# DEFAULT_REPLY_TO=founder@example.com

# Apollo.io (email discovery for outreach)
# APOLLO_API_KEY=your-apollo-api-key
